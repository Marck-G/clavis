LDAP_URL=ldap://localhost:389
LDAP_BASE_DN=DC=example,DC=com
BIND_ADDRESS=0.0.0.0:4000
RUST_LOG=info

# Admin account for password changes (service account with password reset permissions)
LDAP_SERVICE_USER=CN=PasswordReset,CN=Users,DC=example,DC=com
LDAP_SERVICE_PASSWORD=your-service-account-password
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=example@example.org
